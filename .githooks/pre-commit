#!/usr/bin/env bash
# Keeps the measured tables in docs/memory-map.md current: when a commit touches anything that ends
# up in the firmware or the file system, tools/measure_memory.py measures again and the doc is staged.
# `nix develop` turns this hook on; NEOTIME_SKIP_MEMORY_MAP=1 skips it for one commit.

set -euo pipefail

if [ -n "${NEOTIME_SKIP_MEMORY_MAP:-}" ]; then
    exit 0
fi

measured_paths='^(firmware|app-host|runtime|ui|drivers|services|boot|apps|faces|sdk|third_party)/|^tools/measure_memory\.py$|^Cargo\.lock$'
if ! git diff --cached --name-only | grep -qE "$measured_paths"; then
    exit 0
fi

# The doc is rewritten in place, so unstaged edits to it would be swept into the commit.
if ! git diff --quiet -- docs/memory-map.md; then
    echo "pre-commit: docs/memory-map.md has unstaged changes; stage or set them aside so its tables can be measured again" >&2
    exit 1
fi

cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: measuring the firmware and file system for docs/memory-map.md"
if [ -n "${IN_NIX_SHELL:-}" ]; then
    python3 -I tools/measure_memory.py
else
    nix develop --command python3 -I tools/measure_memory.py
fi
git add docs/memory-map.md
