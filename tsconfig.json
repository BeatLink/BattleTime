{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["sdk/**/*.ts", "sdk/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx", "faces/**/*.ts", "faces/**/*.tsx", "shell/**/*.ts", "shell/**/*.tsx", "vite.config.ts"],
  "exclude": ["**/node_modules"]
}
