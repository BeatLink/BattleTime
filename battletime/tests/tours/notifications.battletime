# Every screen of the notifications shade, for docs/apps/notifications.md: empty, a list, one read in full, and the preview.
open app notifications
expect text "No notifications"
# Each shows the icon and colour for its app: a blue text, a purple calendar event, a yellow email, a red missed call and a blue chat.
notify "SMS" "Sam" "On my way, see you at the station in ten minutes"
notify "Calendar" "Calendar" "Team meeting at 10:00 in room 4"
notify "Email" "Robin" "Invoice for October attached"
notify "Phone" "Jamie" "Missed call"
notify "Messages" "Alex" "Running late, start without me"
expect text "Alex"
snapshot list
tap "Alex"                  # the newest notification
expect screen message
expect text "Running late"
snapshot message
tap "Dismiss"
expect screen main
expect no text "Alex"
notify "Calendar" "Dentist appointment tomorrow" "Bring your card"  # a long title wraps
start on preview            # as the shell opens it when a notification arrives
expect text "Dentist appointment"
expect text "Bring your card"
snapshot preview
wait 6s
expect no effect back
notify "Jo" "Lunch at noon?"  # a newer one starts the preview again
expect text "Jo"
wait 6s
expect no effect back
wait 2s
expect effect back          # the preview goes back by itself after 7 seconds
start on preview
tap "Jo"                    # a tap reads it in full and keeps it
expect text "Dismiss"
snapshot preview-open
wait 10s
expect no effect back
tap "Dismiss"
expect effect back
expect no failures
