# Every screen of the settings app, for docs/apps/settings.md: the list, each screen of choices, and the date and time pages.
open app settings
set settings.screen_timeout_seconds 15
set settings.always_on_screen false
expect text "15 s"
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
expect text "Updates"
tap "Updates"               # the updates row steps through off, on and until restart
expect effect set-setting allows_updates 2
set settings.allows_updates 2
expect text "Temporary"
snapshot list-end
open app settings
set settings.screen_timeout_seconds 15
tap "Brightness"            # the brightness row
expect screen brightness
snapshot brightness
tap "High"
expect effect set-setting brightness 3
button
tap "Screen off"            # the screen timeout row
expect screen timeout
tap "30 s"
expect effect set-setting screen_timeout_seconds 30
snapshot timeout
button
tap "Wake"                  # the wake row
expect screen wake
set settings.raise_to_wake true
expect text "Shake strength"
snapshot wake
tap "Touch"                 # which touch wakes the screen
expect screen wake_touch
snapshot wake-touch
tap "Double tap"
expect effect set-setting wake_on_touch 2
button
tap "Shake strength"        # the shake calibration
expect screen shake_threshold
set shake_speed 900
expect text "Calibrate"
snapshot shake
tap "Calibrate"
expect text "Ready!"
wait 2s
expect text "Shake!"
set shake_speed 1500
wait 300ms
expect text "1200"
snapshot shake-recording
wait 8s
expect text "Calibrate"
expect effect set-setting shake_threshold 1200
button
button
swipe up
swipe up
tap "Step goal"             # the step goal row
expect screen step_goal
expect text "Daily step goal"
snapshot step-goal
button
expect screen main
swipe up
swipe up
swipe up
tap "Chimes"                # the chimes row
expect screen chimes
set settings.chimes 1
expect text "Every hour"
snapshot chimes
button
swipe up
swipe up
swipe up
swipe up
tap "Heart rate"            # the heart rate interval row
expect screen heart_rate_interval
set settings.heart_rate_interval 4
expect text "5 min"
snapshot heart-rate
tap "Always"
expect effect set-setting heart_rate_interval 1
button
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
tap "Face"                  # the watch face chooser
expect screen watch_face
expect text "Digital"
snapshot watch-face
tap 204 140                 # the next face
expect effect step-watch-face 1
tap 36 140                  # the face before
expect effect step-watch-face -1
button
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
tap "Theme"                 # the theme row
expect screen theme
expect text "Ocean"
snapshot theme
open app settings
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
swipe up
tap "Date & time"           # setting the clock by hand, starting from the time now
expect screen clock
snapshot date
set settings.uses_24_hour_clock false
swipe left                  # the time page, here on a 12 hour clock
expect text "Set"
snapshot time
tap "Set"
expect effect set-clock 2026 5 540
expect screen main
expect no failures
