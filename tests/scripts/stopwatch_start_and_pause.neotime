# The stopwatch counts up once started and holds its time while paused.
open app stopwatch
expect screen main
expect text "00:00"

tap 178 200                 # the start button, bottom right
wait 3s
expect text "00:03"
expect effect keep-screen-on true

tap 178 200                 # pause
expect effect keep-screen-on false
wait 1min
expect text "00:03"
expect no text "01:03"
expect no failures
