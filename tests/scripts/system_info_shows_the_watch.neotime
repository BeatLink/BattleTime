# System info shows the firmware version, the uptime, why the watch restarted, the battery and the free storage, and keeps them current.
open app system-info
expect text "0.1.0+1b19aed"
expect text "0d 03:25:00"
expect text "watchdog"
expect text "87%"
expect text "2.7 MB free"
wait 2s
expect text "0d 03:25:02"
wait 21h
expect text "1d 00:25:02"
set battery_percent 42
set is_charging true
expect text "42% charging"
set free_storage_kilobytes 512
expect text "512 KB free"
expect no failures
