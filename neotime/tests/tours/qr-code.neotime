# Every screen of the QR code app, for docs/apps/qr-code.md: the list, a code with its caption, then with no codes.
open app qr-code
expect text "example.com"
expect text "Guest Wi-Fi"
tap "example.com"
expect screen code
snapshot code
write "/qr/list" ""   # the phone takes every code off
reopen
expect text "No QR codes yet"
snapshot empty
expect no failures
