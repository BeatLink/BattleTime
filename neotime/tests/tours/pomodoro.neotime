# Every screen of the pomodoro app, for docs/apps/pomodoro.md: the three lengths, then the countdown through a round.
open app pomodoro
expect text "Pomodoro"
expect text "25 / 5 / 15 min"
swipe right                 # to the long break page
expect text "Long break"
expect text "After 4 work sessions"
snapshot long-break
swipe right                 # to the short break page
expect text "Short break"
snapshot short-break
swipe right                 # to the work page
expect text "Work"
snapshot work
swipe left
swipe left
swipe left                  # back to the countdown
tap "Start"
expect text "Work"
expect text "1 of 4"
expect text "25:00"
snapshot running
wait 25min
expect text "Short break next"
expect effect vibrate-pattern alarm
snapshot ringing
wait 10s
expect text "Short break"
expect text "05:00"
expect text "1 of 4"
snapshot short-break-running
wait 5min
wait 10s
expect text "2 of 4"
tap "Stop"
expect text "Pomodoro"
expect no failures
