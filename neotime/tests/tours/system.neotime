# Every screen of the system app, for docs/apps/system.md: the system page, each state of the battery page, then the memory, bootloader, hardware, tasks and licence pages.
open app system
expect text "0d 03:25:00"
expect text "2026-01-04"
swipe left
expect text "Discharging"
set is_charging true
wait 2s
expect text "Charging"
snapshot battery-charging
set is_charging false
set battery_percent 100
set battery_millivolts 4180
expect text "Fully charged"
snapshot battery-full
set battery_percent 9
set battery_millivolts 3640
expect text "Battery low"
expect text "Charge now"
snapshot battery-low
set battery_percent 4
set battery_millivolts 3420
expect text "Almost empty"
snapshot battery-critical
swipe left
expect text "2.7 MB"
expect text "18.0 KB"
expect text "12.0 KB"
snapshot memory
swipe left
expect text "0.1.0+0c4e2d1"
expect text "2025-12-20"
snapshot bootloader
swipe left
expect text "D1:2A:5C:7E:90:3B"
expect text "XT25F32B 0B4016"
expect text "CST816S v2"
expect text "BMA425"
snapshot hardware
swipe left
expect text "shell"
expect text "0.4%"
expect text "5210"
snapshot tasks
swipe left
expect text "Licence"
snapshot licence
expect no failures
