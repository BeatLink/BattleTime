# The system app opens on the firmware version, the uptime, why the watch restarted and the free storage, and keeps them current.
open app system
expect screen main
expect text "0.1.0+1b19aed"
expect text "0d 03:25:00"
expect text "watchdog"
expect text "2.7 MB free"
wait 2s
expect text "0d 03:25:02"
wait 21h
expect text "1d 00:25:02"
set free_storage_kilobytes 512
expect text "512 KB free"

# Swiping left turns to the battery page: the charge, its state and the voltage, and a warning to charge below ten percent.
swipe left
expect screen main
expect no text "512 KB free"
expect text "87%"
expect text "Discharging"
expect text "4.05 volts"

set battery_percent 9
set battery_millivolts 3640
expect text "Battery low"
expect text "Charge now"

set is_charging true
expect text "Charging"
expect text "3.64 volts"
expect no text "Charge now"

set is_charging false
set battery_percent 100
set battery_millivolts 4180
expect text "Fully charged"

# Swiping right turns back to the system page.
swipe right
expect screen main
expect text "512 KB free"
expect no failures
