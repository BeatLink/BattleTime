{
  "name": "battletime-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "coverage": "jest --coverage",
    "tauri": "vite build && cargo run --release -p battletime-companion",
    "tauri-android": "cd tauri && cargo tauri android build --debug --apk --target aarch64",
    "tauri-android:release": "cd tauri && cargo tauri android build --apk --target aarch64 armv7 i686 x86_64",
    "build:cli": "esbuild cli/battletime.ts --bundle --platform=node --target=node20 --format=cjs --external:node-ble --alias:@=./src --outfile=build/battletime.cjs",
    "battletime": "npm run build:cli --silent && node build/battletime.cjs",
    "import-watch-apps": "node scripts/import-watch-apps.mjs",
    "import-system-files": "node scripts/import-system-files.mjs",
    "import-icon-names": "node scripts/import-icon-names.mjs",
    "build-plugin": "node scripts/build-plugin.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "node-ble": "^1.13.0",
    "preact": "^11.0.1",
    "qrcode": "^1.5.4"
  },
  "license": "GPL-3.0-or-later",
  "jest": {
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "cli/**/*.ts",
      "!**/*.test.{ts,tsx}",
      "!**/*.d.ts",
      "!src/main.tsx",
      "!src/screens/**",
      "!src/components/**",
      "!src/ble/tauri-transport.ts",
      "!src/ble/create-transport.ts",
      "!cli/battletime.ts",
      "!cli/ble.ts"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "branches": 79,
        "functions": 78
      }
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/build/",
      "/tauri/gen/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!preact/)"
    ],
    "transform": {
      "\\.[cm]?[jt]sx?$": "babel-jest"
    }
  },
  "bin": {
    "battletime": "./build/battletime.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.5",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
